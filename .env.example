# AUREX configuration. Copy to `.env` (never commit `.env`). Backend settings use the AUREX_ prefix and are
# read by the API, the Celery worker/beat and the seed job. docker-compose.yml also reads POSTGRES_* and the
# edge/backup variables from this file.
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                  # JWT secret
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     # Fernet key

# ---- Runtime ---------------------------------------------------------------------------------------------
AUREX_ENV=production                      # development | test | production (production refuses unsafe defaults)
AUREX_LOG_LEVEL=INFO
AUREX_LOG_JSON=true

# ---- Database (docker-compose builds AUREX_DATABASE_URL from these) -------------------------------------
POSTGRES_USER=aurex
POSTGRES_PASSWORD=                        # REQUIRED: long random password
POSTGRES_DB=aurex
# Outside docker-compose set the URL directly:
# AUREX_DATABASE_URL=postgresql+psycopg://aurex:<password>@db-host:5432/aurex
AUREX_DATABASE_POOL_SIZE=10

# ---- Security (REQUIRED in production) ------------------------------------------------------------------
AUREX_JWT_SECRET=                         # REQUIRED: >= 32 random characters
AUREX_SECRET_ENCRYPTION_KEY=              # REQUIRED: Fernet key; encrypts integration credentials at rest
AUREX_COOKIE_SECURE=true                  # HTTPS-only cookies (required in production)
# AUREX_COOKIE_DOMAIN=aurex.example.com
AUREX_ACCESS_TOKEN_TTL_MINUTES=15
AUREX_REFRESH_TOKEN_TTL_DAYS=14
AUREX_PASSWORD_MIN_LENGTH=10
AUREX_MAX_FAILED_LOGINS=5
AUREX_LOCKOUT_MINUTES=15
AUREX_INVITATION_TTL_DAYS=7
# Reverse proxies in front of the API that overwrite/append X-Forwarded-For (docker-compose sets 1 for Caddy).
# Leave 0 when the API is reached directly, so clients cannot spoof their address.
# AUREX_TRUSTED_PROXY_HOPS=1

# ---- Rate limits (per minute; shared through Redis when AUREX_REDIS_URL is set) -------------------------
AUREX_RATE_LIMIT_ENABLED=true
AUREX_RATE_LIMIT_AUTH_PER_MINUTE=10
AUREX_RATE_LIMIT_API_PER_MINUTE=600
AUREX_RATE_LIMIT_ADVISOR_PER_MINUTE=20

# ---- Background jobs -------------------------------------------------------------------------------------
# docker-compose sets AUREX_TASK_BACKEND=celery and AUREX_REDIS_URL=redis://redis:6379/0.
# AUREX_TASK_BACKEND=inline               # single-process installs: jobs run on an in-process thread pool
# AUREX_REDIS_URL=redis://localhost:6379/0
AUREX_MAX_UPLOAD_MB=25

# ---- Optional integrations (features stay honest and degrade gracefully when unset) ---------------------
# AI advisor: without a key it runs in deterministic tool-routing mode (validated analyses only).
# AUREX_ANTHROPIC_API_KEY=
AUREX_ADVISOR_MODEL=claude-opus-5-5
AUREX_ADVISOR_MAX_TOOL_ROUNDS=6
# Market data: without a provider only stored, dated and sourced snapshots are shown.
AUREX_MARKET_DATA_PROVIDER=none           # none | alphavantage | twelvedata
# AUREX_MARKET_DATA_API_KEY=
# News: fetch the configured RSS/official sources on a schedule (hourly via Celery beat).
AUREX_NEWS_FETCH_ENABLED=false
# Allow connectors to reach private networks (on-premise databases/APIs). Keep false for SaaS installs.
AUREX_ALLOW_PRIVATE_NETWORK_CONNECTORS=false

# ---- Demo mode (synthetic NovaMart data + one-click demo sign-in) ---------------------------------------
# Must be false for any installation holding real customer data.
AUREX_DEMO_MODE=false
# A public showcase that holds ONLY synthetic data may run demo mode with AUREX_ENV=production:
# AUREX_DEMO_MODE=true
# AUREX_ALLOW_DEMO_IN_PRODUCTION=true

# ---- Data retention (days; 0 disables purging for that class) -------------------------------------------
AUREX_RETENTION_AUDIT_DAYS=730
AUREX_RETENTION_SYNC_ERROR_DAYS=180
AUREX_RETENTION_NOTIFICATION_DAYS=180
AUREX_RETENTION_REPORT_DAYS=365

# ---- Edge proxy & backups (docker-compose) --------------------------------------------------------------
AUREX_SITE_ADDRESS=:80                    # a hostname (e.g. aurex.example.com) enables automatic HTTPS
AUREX_HTTP_PORT=80
AUREX_HTTPS_PORT=443
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
